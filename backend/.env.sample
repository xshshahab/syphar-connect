MONGO_URI=paste-your-own-mongo-uri
SECRET_KEY=yousecretgoeshere@123thesecureone
PORT=8080

# Folder where uploaded files (photos, logos, resumes) are stored.
# Absolute path, or relative to the backend folder.
# Development: keep them outside the backend folder, in the project root.
UPLOAD_DIR=../uploads
# Production example: UPLOAD_DIR=/var/data/syphar-uploads

# Public base URL used when building links to uploaded files (optional).
# Defaults to the incoming request host, e.g. http://localhost:8080
BASE_URL=http://localhost:8080
