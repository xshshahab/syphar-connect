MONGO_URI=paste-your-own-mongo-uri
SECRET_KEY=yousecretgoeshere@123thesecureone
PORT=8080

# Folder where uploaded files (photos, logos, resumes) are stored.
# Absolute path, or relative to the backend folder.
# Development: keep them outside the backend folder, in the project root.
UPLOAD_DIR=../uploads
# Production example: UPLOAD_DIR=/var/data/syphar-uploads

# Public base URL used when building links to uploaded files (optional).
# Leave it unset: links then use the address the request came in on
# (http://localhost:8080 in development, your own domain behind nginx).
# These links are saved in the database, so if you set it, use the public
# address, e.g. BASE_URL=https://jobs.shahabuddin.in
# BASE_URL=

# Production only: set NODE_ENV=production so the login cookie is HTTPS-only.
# NODE_ENV=production

# Origin of the client when it is served from a different address than the API
# (development default: http://localhost:5173). Not needed when nginx serves
# both from one domain.
# CLIENT_URL=http://localhost:5173
