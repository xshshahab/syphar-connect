# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:5432/DBNAME
# If the password contains special characters (@ : / # ? %), percent-encode
# them, e.g. @ becomes %40.
DATABASE_URL=postgresql://syphar:CHANGE_ME@127.0.0.1:5432/syphar_connect

# Signs the login cookie. Reuse the SECRET_KEY of the old Node API and
# people who are already logged in stay logged in. Use 32+ characters.
SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars

# Folder where uploaded files (photos, logos, resumes) are stored.
# Absolute path, or relative to the backend-fastapi folder.
# Development: keep them outside this folder, in the project root.
UPLOAD_DIR=../uploads
# Production example: UPLOAD_DIR=/var/data/syphar-uploads

# Public base URL used when building links to uploaded files (optional).
# Leave it unset: links then use the address the request came in on
# (run uvicorn with --proxy-headers behind nginx so that is your domain).
# These links are saved in the database, so if you set it, use the public
# address, e.g. BASE_URL=https://jobs.shahabuddin.in
# BASE_URL=

# Production only: makes the login cookie HTTPS-only.
# ENVIRONMENT=production

# Origin of the client when it is served from a different address than the API
# (development default: http://localhost:5173). Not needed when nginx serves
# both from one domain.
# CLIENT_URL=http://localhost:5173
