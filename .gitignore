# ---------------------------------------------------------------------------
# Only source code goes to GitHub. Anything that can be re-installed,
# re-built or re-generated, and anything secret, stays out.
# ---------------------------------------------------------------------------

# Dependencies (re-installed with `npm install` / `pip install -r requirements.txt`)
node_modules/
.venv/
venv/
env/
__pycache__/
*.py[cod]
.eggs/
*.egg-info/

# Secrets: real environment files are NEVER committed.
# The *.sample templates are, so others know which variables to set.
.env
.env.*
!.env.sample
*.env

# Uploaded files (profile photos, logos, resumes): user data, not source code
uploads/

# Local-only notes (server deployment guide). Kept on this machine, not on GitHub.
DEPLOYMENT.md

# Build output and caches
dist/
dist-ssr/
build/
coverage/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
*.tsbuildinfo
.vite/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database dumps and local data
*.sql
*.dump
*.sqlite3

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Misc
*.tgz
*.zip
